{
  "PreToolUse": [
    {
      "matcher": "exec",
      "hooks": [
        {
          "type": "command",
          "command": "python -c \"import runpy, os; runpy.run_path(os.path.join(os.environ['DEVIN_PROJECT_DIR'], '.devin', 'hooks', 'git_guard.py'), run_name='__main__')\"",
          "timeout": 5
        }
      ]
    }
  ]
}
