{
  "servers": {
    "dev": {
      "url": "http://localhost:8001",
      "username": "admin",
      "password": "admin",
      "notes": "Local devcontainer - InvenTree server on forwarded port 8001. `postCreateCommand.sh` reads these credentials and ensures the user exists with this password, so the E2E test and the dev admin account stay in sync."
    },
    "staging": {
      "plugin_dir": "/opt/inventree/plugins",
      "url": "https://staging.example.com",
      "api_key": "your-staging-api-key-here",
      "ssh": {
        "host": "staging.server.com",
        "user": "inventree",
        "port": 22,
        "password": "",
        "key_file": ""
      },
      "compose_dir": "/opt/inventree",
      "service_name": "inventree-server",
      "data_dir": "/opt/inventree/inventree-data",
      "container_data_path": "/home/inventree/data",
      "docker_command": "docker compose",
      "notes": "Test server - deploy here first for testing. For Deploy-Plugin.ps1, ssh.host is required. The optional compose_dir/service_name/data_dir/docker_command override auto-detection."
    },
    "production": {
      "plugin_dir": "/opt/inventree/plugins",
      "url": "https://production.example.com",
      "api_key": "your-production-api-key-here",
      "ssh": {
        "host": "prod.server.com",
        "user": "inventree",
        "port": 22,
        "password": "",
        "key_file": ""
      },
      "compose_dir": "/opt/inventree",
      "service_name": "inventree-server",
      "data_dir": "/opt/inventree/inventree-data",
      "container_data_path": "/home/inventree/data",
      "docker_command": "docker compose",
      "notes": "Live production server - deploy with caution. For Deploy-Plugin.ps1, ssh.host is required. The optional compose_dir/service_name/data_dir/docker_command override auto-detection."
    }
  },
  "defaults": {
    "author_name": "Jon Robelia",
    "author_email": "you@example.com",
    "license": "MIT",
    "project_url": "https://github.com/jrobelia/inventree-plugin-toolkit"
  },
  "paths": {
    "plugin_creator": "reference/plugin-creator"
  }
}
